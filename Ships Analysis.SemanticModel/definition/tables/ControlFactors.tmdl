	column FactorReturn
		dataType: double
		formatString: 0.0000%;-0.0000%;0.0000%
		lineageTag: 4ae11420-6365-44a0-8065-aabe9c533584
		summarizeBy: none
		sourceColumn: FactorReturn

		annotation SummarizationSetBy = User

	partition ControlFactors = m
		mode: import
		source =
				let
				    // The factor list comes from factors.csv through the Factor query,
				    // so no ticker is named here and FactorRole lives on the Factor table.
				    Source  = FactorPrices,
				
				    Grouped = Table.Group(Source, {"Ticker"}, {{"rows", each _, type table}}),
				
				    // Same per-ticker isolation as the equity portfolios, so no return is ever
				    // computed across two stacked series.
				    WithReturns = Table.AddColumn(Grouped, "withReturn", each
				        let
				            t = Table.Buffer(Table.Sort([rows], {{"Date", Order.Ascending}})),
				            c = List.Buffer(t[Adj Close]),
				            n = List.Count(c),
				            r = List.Transform({0 .. n - 1}, (i) =>
				                  if i = 0 or c{i} = null or c{i - 1} = null then null
				                  else c{i} / c{i - 1} - 1),
				            // Passing the table type keeps every column typed; without it
				            // Table.FromColumns returns all columns as Any.
				            outType = Value.Type(Table.AddColumn(t, "FactorReturn", each null, type number))
				        in
				            Table.FromColumns(Table.ToColumns(t) & {r}, outType)),
				
				    Combined = Table.Combine(WithReturns[withReturn]),
				    Sorted   = Table.Sort(Combined, {{"Ticker", Order.Ascending}, {"Date", Order.Ascending}})
				in
				    Sorted

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

