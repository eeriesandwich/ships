	partition TankerDaily = m
		mode: import
		source =
				let
				    Src   = tanker,
				    Spine = List.Buffer(List.Sort(Table.Column(Sessions, "Date"))),
				
				    Grouped = Table.Group(Src, {"Ticker"}, {{"rows", each _, type table}}),
				
				    Filled = Table.AddColumn(Grouped, "daily", each
				        let
				            t        = Table.Sort([rows], {{"Date", Order.Ascending}}),
				            cols     = List.RemoveItems(Table.ColumnNames(t), {"Date"}),
				            first    = List.Min(t[Date]),
				            last     = List.Max(t[Date]),
				            span     = List.Select(Spine, (d) => d >= first and d <= last),
				            scaffold = Table.TransformColumnTypes(
				                         Table.FromList(span, (d) => {d}, {"Date"}),
				                         {{"Date", type date}}),
				            joined   = Table.NestedJoin(scaffold, {"Date"}, t, {"Date"},
				                         "px", JoinKind.LeftOuter),
				                       // A join does not keep row order, and fill-down and the previous-
				            // observation index both depend on it. Restore date order and pin it.
				            expanded = Table.Buffer(Table.Sort(
				                         Table.ExpandTableColumn(joined, "px", cols),
				                         {{"Date", Order.Ascending}})),
				            marked   = Table.AddColumn(expanded, "IsStale",
				                         each [Ticker] = null, type logical),
				            down     = Table.FillDown(marked, cols),
				            seeded   = Table.SelectRows(down, each [Ticker] <> null),
				
				            real     = Table.SelectRows(seeded, each [IsStale] = false),
				            obsDates = List.Buffer(real[Date]),
				            realIx   = Table.AddIndexColumn(real, "ix", 0, 1, Int64.Type),
				            realPrev = Table.AddColumn(realIx, "PrevObsDate",
				                         each if [ix] = 0 then null else obsDates{[ix] - 1},
				                         type date),
				            backJoin = Table.NestedJoin(seeded, {"Date"},
				                         Table.SelectColumns(realPrev, {"Date", "PrevObsDate"}),
				                         {"Date"}, "p", JoinKind.LeftOuter),
				            withPrev = Table.ExpandTableColumn(backJoin, "p", {"PrevObsDate"})
				        in
				            withPrev),
				
				    Combined = Table.Combine(Filled[daily]),
				
				    #"Added Venue" = Table.AddColumn(Combined, "Venue", each
				        let i = Text.PositionOf([Ticker], ".", Occurrence.Last)
				        in if i < 0 then "US" else Text.Upper(Text.Range([Ticker], i + 1)),
				        type text),
				
				    #"Sorted" = Table.Sort(#"Added Venue",
				                  {{"Ticker", Order.Ascending}, {"Date", Order.Ascending}}),
				
				    // Membership is resolved after the fill-forward, so a carried row is
				    // classified by its own date rather than inheriting the previous session's.
				    // A ticker with no Membership row in series_windows.csv belongs to its
				    // file's lineage on every date. Outside a Membership window it is
				    // Unclassified: the row stays in the table but leaves the basket.
				    Membership = Table.Buffer(
				                   Table.SelectRows(SeriesWindows, each [WindowType] = "Membership")),
				
				    #"Added MemberLineage" = Table.AddColumn(#"Sorted", "MemberLineage", each
				        let
				            w = Table.SelectRows(Membership, (m) => m[Ticker] = [Ticker])
				        in
				            if Table.IsEmpty(w) then [Lineage]
				            else if List.AnyTrue(List.Transform(Table.ToRecords(w), (m) =>
				                        (m[ValidFrom] = null or [Date] >= m[ValidFrom])
				                    and (m[ValidTo]   = null or [Date] <= m[ValidTo])))
				            then [Lineage]
				            else "Unclassified",
				        type text)
				in
				    #"Added MemberLineage"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

