	partition MediatorTest = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents("C:\Users\Joan Casaramona\Documents\Ships\data\checks\mediator_test_2026-10-20.csv"),
				        [Delimiter=",", Columns=null, Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				    ),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"label", type text},
				        {"focus_q", Int64.Type},
				        {"events", type text},
				        {"window", type text},
				        {"n_years", Int64.Type},
				        {"raw_alpha", type number},
				        {"direct_alpha", type number},
				        {"beta", type number},
				        {"delta_focus", type number},
				        {"mediated_component", type number},
				        {"mediated_share", type number},
				        {"boot_lo", type number},
				        {"boot_hi", type number},
				        {"decision", type text},
				        {"note", type text}
				    }),
				    AddRowLabel = Table.AddColumn(Typed, "Combination",
				        each [label] & " Q" & Text.From([focus_q]),
				        type text
				    ),
				    AddSortOrder = Table.AddColumn(AddRowLabel, "SortOrder",
				        each if Text.StartsWith([label], "BDTI vs Brent") then 10
				             else if Text.StartsWith([label], "BDTI vs WTI") then 11
				             else if Text.Contains([label], "Iron ore") and [focus_q] = 1 then 20
				             else if Text.Contains([label], "Iron ore") and [focus_q] = 3 then 22
				             else if Text.Contains([label], "China") and [focus_q] = 1 then 30
				             else if Text.Contains([label], "China") and [focus_q] = 3 then 32
				             else 99,
				        Int64.Type
				    )
				in
				    AddSortOrder

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

