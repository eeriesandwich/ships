	column FactorKinds
		lineageTag: 12c5811d-1fd7-47fa-8363-51a8e4d88b75
		summarizeBy: none
		isNameInferred
		sourceColumn: [FactorKinds]

		annotation SummarizationSetBy = User

	column FactorsFrom
		formatString: General Date
		lineageTag: 8dda61df-2340-4f6b-abf1-60b3502d333c
		summarizeBy: none
		isNameInferred
		sourceColumn: [FactorsFrom]

		annotation SummarizationSetBy = User

	partition Specification = calculated
		mode: import
		source =
				
				VAR Base =
				    DATATABLE (
				        "Specification", STRING, "SortOrder", INTEGER, "Lineage", STRING, "FactorKinds", STRING,
				        {
				            { "Raw",                         1, "Tanker",  "None" },
				            { "Market-adjusted",             2, "Tanker",  "Market" },
				            { "Market and sector adjusted",  3, "Tanker",  "Market and Sector" },
				            { "Raw",                         1, "DryBulk", "None" },
				            { "Market-adjusted",             2, "DryBulk", "Market" },
				            { "Market and sector adjusted",  3, "DryBulk", "Market and Sector" }
				        }
				    )
				RETURN
				    ADDCOLUMNS (
				        Base,
				        "FactorsFrom",
				            VAR L = [Lineage]
				            VAR K = [FactorKinds]
				            // First date of each factor the specification needs, read from the data.
				            VAR MarketFrom =
				                MINX (
				                    FILTER ( ControlFactors,
				                        ControlFactors[Ticker] IN CALCULATETABLE ( VALUES ( Factor[Ticker] ), Factor[FactorKind] = "Market" ) ),
				                    ControlFactors[Date] )
				            VAR SectorFrom =
				                MAXX (
				                    FILTER ( Factor, Factor[FactorKind] = "Sector" && Factor[SectorLineage] = L ),
				                    VAR T = Factor[Ticker]
				                    RETURN MINX ( FILTER ( ControlFactors, ControlFactors[Ticker] = T ), ControlFactors[Date] ) )
				            RETURN
				                SWITCH ( K,
				                    "None",   BLANK (),
				                    "Market", MarketFrom,
				                    MAX ( MarketFrom, SectorFrom ) )
				    )

	annotation PBI_Id = d8dfa9ff073e4cf7bc65a24c004de60a

