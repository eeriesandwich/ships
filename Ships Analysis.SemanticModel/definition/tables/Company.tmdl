	partition Company = m
		mode: import
		source =
				let
				    Source   = Csv.Document(
				                 File.Contents("C:\Users\Joan Casaramona\Documents\Ships\data\companies.csv"),
				                 [Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
