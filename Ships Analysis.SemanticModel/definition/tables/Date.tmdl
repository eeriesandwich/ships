	column IsInDataRange =
			
			'Date'[Date] >= MIN ( LineagePortfolio[Date] )
			    && 'Date'[Date] <= MAX ( LineagePortfolio[Date] )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 23653324-5108-4045-887a-ea9917319237
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition Date = m
		mode: import
		source =
				let
				    // Span every fact table, so no fact row loses its relationship.
				    // BDI reaches back to 1985, which sets the floor.
				    MinDate = #date(1985, 1, 1),
				    MaxDate = #date(2035, 12, 31),
				
				    Days  = List.Dates(MinDate, Duration.Days(MaxDate - MinDate) + 1, #duration(1,0,0,0)),
				    Base  = Table.TransformColumnTypes(
				              Table.FromList(Days, Splitter.SplitByNothing(), {"Date"}),
				              {{"Date", type date}}),
				
				    Cols = Table.AddColumn(Base, "Year",            each Date.Year([Date]), Int64.Type),
				    C2   = Table.AddColumn(Cols, "QuarterNumber",   each Date.QuarterOfYear([Date]), Int64.Type),
				    C3   = Table.AddColumn(C2,   "Quarter",         each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
				    C4   = Table.AddColumn(C3,   "MonthNumber",     each Date.Month([Date]), Int64.Type),
				    C5   = Table.AddColumn(C4,   "MonthName",       each Date.MonthName([Date], "en-GB"), type text),
				    C6   = Table.AddColumn(C5,   "YearMonth",       each Date.ToText([Date], "yyyy-MM"), type text),
				    C7   = Table.AddColumn(C6,   "YearMonthSort",   each Date.Year([Date]) * 100 + Date.Month([Date]), Int64.Type),
				    C8   = Table.AddColumn(C7,   "YearQuarter",     each Text.From(Date.Year([Date])) & " Q" & Text.From(Date.QuarterOfYear([Date])), type text),
				    C9   = Table.AddColumn(C8,   "YearQuarterSort", each Date.Year([Date]) * 10 + Date.QuarterOfYear([Date]), Int64.Type),
				    C10  = Table.AddColumn(C9,   "DayOfWeekName",   each Date.DayOfWeekName([Date], "en-GB"), type text),
				    C11  = Table.AddColumn(C10,  "DayOfWeekNumber", each Date.DayOfWeek([Date], Day.Monday), Int64.Type),
				    C12  = Table.AddColumn(C11, "DateKey",
				             each Date.Year([Date]) * 10000 + Date.Month([Date]) * 100 + Date.Day([Date]), Int64.Type),
				    // ISO 8601: a week belongs to the year that contains its Thursday.
				    C13  = Table.AddColumn(C12, "ISOYear",
				             each Date.Year(Date.AddDays([Date], 3 - Date.DayOfWeek([Date], Day.Monday))), Int64.Type),
				    C14  = Table.AddColumn(C13, "ISOWeek",
				             each let th = Date.AddDays([Date], 3 - Date.DayOfWeek([Date], Day.Monday))
				                  in Number.IntegerDivide(Date.DayOfYear(th) - 1, 7) + 1, Int64.Type)
				in
				    C14

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

