			        "@y",  CALCULATE ( [Quarter Return] ),
			        "@xm", CALCULATE ( [Market Factor Quarter Return] ),
			        "@d1", IF ( 'Date'[QuarterNumber] = 1, 1, 0 ),
			        "@d2", IF ( 'Date'[QuarterNumber] = 2, 1, 0 ),
			        "@d3", IF ( 'Date'[QuarterNumber] = 3, 1, 0 )
			    )
			VAR Clean = FILTER ( Panel, NOT ISBLANK ( [@y] ) && NOT ISBLANK ( [@xm] ) )
			VAR Betas = LINESTX ( Clean, [@y], [@xm], [@d1], [@d2], [@d3] )
			RETURN MINX ( Betas, [Slope1] )
		formatString: 0.00
		displayFolder: Controls
		lineageTag: cbf2b962-c61b-45f0-93dc-6e9a73a34b03

	measure 'Residual Quarter Return' =
			
			VAR Spec = SELECTEDVALUE ( Specification[Specification], "Raw" )
			VAR Y   = [Quarter Return]
			VAR Xm  = [Market Factor Quarter Return]
			VAR Xs  = [Sector Factor Quarter Return]
			RETURN
			    SWITCH (
			        Spec,
			        "Market-adjusted",             Y - [Beta Market Only] * Xm,
			        "Market and sector adjusted",  Y - [Beta Market] * Xm - [Beta Sector] * Xs,
			        Y
			    )
		formatString: 0.0000%;-0.0000%;0.0000%
		displayFolder: Controls
		lineageTag: 37a1fd0a-c2a5-4074-b802-c59b5a9f7661

	measure 'Quarter Return (Total)' =
			
			CALCULATE ( [Quarter Return], REMOVEFILTERS ( ReturnBasis ), ReturnBasis[Basis] = "Total" )
