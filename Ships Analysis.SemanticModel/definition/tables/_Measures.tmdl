	/// Sum of daily factor log returns within the current quarter for Factor[FactorKind] = Market.
	measure 'Market Factor Quarter Return' =
			
			VAR MarketTickers = CALCULATETABLE ( VALUES ( Factor[Ticker] ), Factor[FactorKind] = "Market" )
			VAR Days = VALUES ( 'Date'[Date] )
			RETURN
			    AVERAGEX (
			        MarketTickers,
			        VAR t = Factor[Ticker]
			        VAR DailyRows =
			            CALCULATETABLE (
			                FILTER (
			                    ADDCOLUMNS ( Days, "@r", CALCULATE ( SUM ( ControlFactors[FactorReturn] ) ) ),
			                    NOT ISBLANK ( [@r] )
			                ),
			                ControlFactors[Ticker] = t
			            )
			        RETURN SUMX ( DailyRows, LN ( 1 + [@r] ) )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Controls\Factors
		lineageTag: 6c294fd6-684f-42ac-a29a-4a7ca13a2a8f


	/// Sum of daily factor log returns within the current quarter for Factor[FactorKind] = Sector, equal-weighted across tickers matching the current lineage.
	measure 'Sector Factor Quarter Return' =
			
			VAR L = SELECTEDVALUE ( Lineage[Lineage] )
			VAR SectorTickers =
			    CALCULATETABLE (
			        VALUES ( Factor[Ticker] ),
			        Factor[FactorKind] = "Sector",
			        Factor[SectorLineage] = L
			    )
			VAR Days = VALUES ( 'Date'[Date] )
			RETURN
			    AVERAGEX (
			        SectorTickers,
			        VAR t = Factor[Ticker]
			        VAR DailyRows =
			            CALCULATETABLE (
			                FILTER (
			                    ADDCOLUMNS ( Days, "@r", CALCULATE ( SUM ( ControlFactors[FactorReturn] ) ) ),
			                    NOT ISBLANK ( [@r] )
			                ),
			                ControlFactors[Ticker] = t
			            )
			        RETURN SUMX ( DailyRows, LN ( 1 + [@r] ) )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Controls\Factors
		lineageTag: d571f87b-215c-44c6-88c1-ed80baa67bfc

	/// Market-model slope on the sector factor from the quarterly OLS fit, by lineage. Used under Market and sector adjusted.
	measure 'Beta Sector' =
			
			VAR Panel =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( 'Date', 'Date'[Year], 'Date'[QuarterNumber] ),
			            REMOVEFILTERS ( 'Date' )
			        ),
			        "@y",  CALCULATE ( [Quarter Return] ),
			        "@xm", CALCULATE ( [Market Factor Quarter Return] ),
			        "@xs", CALCULATE ( [Sector Factor Quarter Return] ),
			        "@d1", IF ( 'Date'[QuarterNumber] = 1, 1, 0 ),
			        "@d2", IF ( 'Date'[QuarterNumber] = 2, 1, 0 ),
			        "@d3", IF ( 'Date'[QuarterNumber] = 3, 1, 0 )
			    )
			VAR Clean =
			    FILTER (
			        Panel,
			        NOT ISBLANK ( [@y] ) && NOT ISBLANK ( [@xm] ) && NOT ISBLANK ( [@xs] )
			    )
			VAR Betas = LINESTX ( Clean, [@y], [@xm], [@xs], [@d1], [@d2], [@d3] )
			RETURN MINX ( Betas, [Slope2] )
		formatString: 0.00
		displayFolder: Controls\Betas
		lineageTag: 2d82feaf-a2ef-48e6-8c57-09284f4a9c25

	/// Market-model slope on the market factor from the quarterly OLS fit with quarter dummies and the sector factor, by lineage.
	measure 'Beta Market' =
			
			VAR Panel =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( 'Date', 'Date'[Year], 'Date'[QuarterNumber] ),
			            REMOVEFILTERS ( 'Date' )
			        ),
			        "@y",  CALCULATE ( [Quarter Return] ),
			        "@xm", CALCULATE ( [Market Factor Quarter Return] ),
			        "@xs", CALCULATE ( [Sector Factor Quarter Return] ),
			        "@d1", IF ( 'Date'[QuarterNumber] = 1, 1, 0 ),
			        "@d2", IF ( 'Date'[QuarterNumber] = 2, 1, 0 ),
			        "@d3", IF ( 'Date'[QuarterNumber] = 3, 1, 0 )
			    )
			VAR Clean =
			    FILTER (
			        Panel,
			        NOT ISBLANK ( [@y] ) && NOT ISBLANK ( [@xm] ) && NOT ISBLANK ( [@xs] )
			    )
			VAR Betas = LINESTX ( Clean, [@y], [@xm], [@xs], [@d1], [@d2], [@d3] )
			RETURN MINX ( Betas, [Slope1] )
		formatString: 0.00
		displayFolder: Controls\Betas
		lineageTag: c0b5c5bd-1418-4369-af14-da1fe3a3b3f5

	/// Market-model slope on the market factor from the quarterly OLS fit with quarter dummies only, by lineage. Used under Market-adjusted.
	measure 'Beta Market Only' =
			
			VAR Panel =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( 'Date', 'Date'[Year], 'Date'[QuarterNumber] ),
			            REMOVEFILTERS ( 'Date' )
			        ),
			        "@y",  CALCULATE ( [Quarter Return] ),
			        "@xm", CALCULATE ( [Market Factor Quarter Return] ),
			        "@d1", IF ( 'Date'[QuarterNumber] = 1, 1, 0 ),
			        "@d2", IF ( 'Date'[QuarterNumber] = 2, 1, 0 ),
			        "@d3", IF ( 'Date'[QuarterNumber] = 3, 1, 0 )
			    )
			VAR Clean = FILTER ( Panel, NOT ISBLANK ( [@y] ) && NOT ISBLANK ( [@xm] ) )
			VAR Betas = LINESTX ( Clean, [@y], [@xm], [@d1], [@d2], [@d3] )
			RETURN MINX ( Betas, [Slope1] )
		formatString: 0.00
		displayFolder: Controls\Betas
		lineageTag: cbf2b962-c61b-45f0-93dc-6e9a73a34b03

	/// Quarter Return minus the fitted market and sector contributions under the current Specification. Equals Quarter Return under Raw.
	measure 'Residual Quarter Return' =
			
			VAR Spec = SELECTEDVALUE ( Specification[Specification], "Raw" )
			VAR Y   = [Quarter Return]
			VAR Xm  = [Market Factor Quarter Return]
			VAR Xs  = [Sector Factor Quarter Return]
			RETURN
			    SWITCH (
			        Spec,
			        "Market-adjusted",             Y - [Beta Market Only] * Xm,
			        "Market and sector adjusted",  Y - [Beta Market] * Xm - [Beta Sector] * Xs,
			        Y
			    )
		formatString: 0.0000%;-0.0000%;0.0000%
		displayFolder: Controls
		lineageTag: 37a1fd0a-c2a5-4074-b802-c59b5a9f7661

	/// Quarter Return under ReturnBasis = Total (USD, dividend-adjusted).
	measure 'Quarter Return (Total)' =
			
			CALCULATE ( [Quarter Return], REMOVEFILTERS ( ReturnBasis ), ReturnBasis[Basis] = "Total" )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Base\Decomposition
		lineageTag: 350088f8-2d8c-47d3-9c73-6571955a49c0


	/// Quarter Return under ReturnBasis = Price (USD, no dividend adjustment).
	measure 'Quarter Return (Price)' =
			
			CALCULATE ( [Quarter Return], REMOVEFILTERS ( ReturnBasis ), ReturnBasis[Basis] = "Price" )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Base\Decomposition
		lineageTag: ada27eff-cc81-4a92-9a2f-7e13ce83ee97


	/// Quarter Return under ReturnBasis = Local (dividend-adjusted, local currency, strips FX).
	measure 'Quarter Return (Local)' =
			
			CALCULATE ( [Quarter Return], REMOVEFILTERS ( ReturnBasis ), ReturnBasis[Basis] = "Local" )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Base\Decomposition
		lineageTag: 044c4248-d43e-40df-8fc7-85519902b4e4


	/// Quarter Return (Total) minus Quarter Return (Price). The dividend contribution to the quarterly return.
	measure 'Payout Effect' =
			
			[Quarter Return (Total)] - [Quarter Return (Price)]
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Base\Decomposition
		lineageTag: 43f936f3-4dc0-412d-a9a4-91258b732f8f


	/// Quarter Return (Total) minus Quarter Return (Local). The FX contribution to the USD return.
	measure 'FX Effect' =
			
			[Quarter Return (Total)] - [Quarter Return (Local)]
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Base\Decomposition
		lineageTag: 8ba28900-2f3e-4091-b43a-20b875f51789


	/// Within-year deviation for the most recent year in the panel for the current quarter.
	measure 'Seasonal Deviation Latest Year' =
			
			VAR Q = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			VAR Panel =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                SUMMARIZE ( 'Date', 'Date'[Year], 'Date'[QuarterNumber] ),
			                REMOVEFILTERS ( 'Date'[QuarterNumber] )
			            ),
			            "@q", CALCULATE ( [Residual Quarter Return] )
			        ),
			        NOT ISBLANK ( [@q] )
			    )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Panel, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Panel, 'Date'[Year] = y ) )
			        ),
			        [@n] = 4
			    )
			VAR Dev =
			    ADDCOLUMNS (
			        FILTER (
			            Panel,
			            'Date'[QuarterNumber] = Q
			                && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			        ),
			        "@dev",
			            VAR y = 'Date'[Year]
			            RETURN [@q] - AVERAGEX ( FILTER ( Panel, 'Date'[Year] = y ), [@q] )
			    )
			VAR LatestY = MAXX ( Dev, 'Date'[Year] )
			RETURN
			    MAXX ( FILTER ( Dev, 'Date'[Year] = LatestY ), [@dev] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seasonality\YoY
		lineageTag: 4aad8fbf-7be0-4238-9238-b4b1b4f0de7e

	/// Latest year's deviation minus the mean of all other years' deviations for the current quarter.
	measure 'Seasonal Deviation YoY' =
			
			VAR Q = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			VAR Panel =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                SUMMARIZE ( 'Date', 'Date'[Year], 'Date'[QuarterNumber] ),
			                REMOVEFILTERS ( 'Date'[QuarterNumber] )
			            ),
			            "@q", CALCULATE ( [Residual Quarter Return] )
			        ),
			        NOT ISBLANK ( [@q] )
			    )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Panel, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Panel, 'Date'[Year] = y ) )
			        ),
			        [@n] = 4
			    )
			VAR Dev =
			    ADDCOLUMNS (
			        FILTER (
			            Panel,
			            'Date'[QuarterNumber] = Q
			                && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			        ),
			        "@dev",
			            VAR y = 'Date'[Year]
			            RETURN [@q] - AVERAGEX ( FILTER ( Panel, 'Date'[Year] = y ), [@q] )
			    )
			VAR LatestY     = MAXX ( Dev, 'Date'[Year] )
			VAR LatestDev   = MAXX ( FILTER ( Dev, 'Date'[Year] = LatestY ), [@dev] )
			VAR OtherDevAvg = AVERAGEX ( FILTER ( Dev, 'Date'[Year] <> LatestY ), [@dev] )
			RETURN
			    LatestDev - OtherDevAvg
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seasonality\YoY
		lineageTag: 0ef1850b-4f23-4614-b83b-6d5013005a91

	/// The year used by the Latest Year deviation measure.
	measure 'Latest Year Used' =
			
			VAR Q = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			VAR Panel =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                SUMMARIZE ( 'Date', 'Date'[Year], 'Date'[QuarterNumber] ),
			                REMOVEFILTERS ( 'Date'[QuarterNumber] )
			            ),
			            "@q", CALCULATE ( [Residual Quarter Return] )
			        ),
			        NOT ISBLANK ( [@q] )
			    )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Panel, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Panel, 'Date'[Year] = y ) )
			        ),
			        [@n] = 4
			    )
			VAR Dev =
			    FILTER (
			        Panel,
			        'Date'[QuarterNumber] = Q
			            && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			    )
			RETURN
			    MAXX ( Dev, 'Date'[Year] )
		formatString: 0
		displayFolder: Seasonality\YoY
		lineageTag: 43fd1bc0-a8bd-4db9-9680-fe67b8841c97

	/// Count of events in the EventStudy table under current filters.
	measure 'ES Event Count' = COUNTROWS ( EventStudy )
		formatString: 0
		displayFolder: Events
		lineageTag: 8ff7cbe9-1606-4657-b3fe-1ab691703e1f

	/// Average cumulative abnormal return across events in context.
	measure 'ES CAR' = AVERAGE ( EventStudy[car] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Events
		lineageTag: b1fdcbc8-6808-4843-9718-9c80e509e791

	/// Share of events in context with two-sided p-value below 0.05.
	measure 'ES Significant Share' =
			
			DIVIDE (
			    COUNTROWS ( FILTER ( EventStudy, EventStudy[p_two_sided] < 0.05 ) ),
			    COUNTROWS ( EventStudy )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Events
		lineageTag: 6c32709f-b2d4-413a-8891-b9a7ed9a5dc2

	/// Pearson correlation between daily freight change and lagged Portfolio Return across US sessions, at the current LagDays value.
	measure 'Freight-Equity Correlation (Daily)' =
			
			VAR LagN = SELECTEDVALUE ( LagDays[Lag], 0 )
			VAR Sessions =
			    CALCULATETABLE (
			        VALUES ( 'Date'[USSessionIndex] ),
			        NOT ISBLANK ( 'Date'[USSessionIndex] )
			    )
			VAR Panel =
			    FILTER (
			        ADDCOLUMNS (
			            Sessions,
			            "@f",
			                VAR S = 'Date'[USSessionIndex]
			                VAR D = CALCULATE ( MAX ( 'Date'[Date] ), 'Date'[USSessionIndex] = S )
			                RETURN
			                    CALCULATE (
			                        DIVIDE ( MAX ( freight[Close] ) - MAX ( freight[PrevClose] ), MAX ( freight[PrevClose] ) ),
			                        'Date'[Date] = D
			                    ),
			            "@e",
			                VAR S = 'Date'[USSessionIndex]
			                VAR LaggedDate =
			                    CALCULATE (
			                        MAX ( 'Date'[Date] ),
			                        'Date'[USSessionIndex] = S + LagN
			                    )
			                RETURN CALCULATE ( [Portfolio Return], 'Date'[Date] = LaggedDate )
			        ),
			        NOT ISBLANK ( [@f] ) && NOT ISBLANK ( [@e] )
			    )
			VAR N   = COUNTROWS ( Panel )
			VAR SX  = SUMX ( Panel, [@f] )
			VAR SY  = SUMX ( Panel, [@e] )
			VAR SXY = SUMX ( Panel, [@f] * [@e] )
			VAR SXX = SUMX ( Panel, [@f] * [@f] )
			VAR SYY = SUMX ( Panel, [@e] * [@e] )
			VAR Num = N * SXY - SX * SY
			VAR Den = SQRT ( ( N * SXX - SX * SX ) * ( N * SYY - SY * SY ) )
			RETURN
			    DIVIDE ( Num, Den )
		formatString: 0.0000
		displayFolder: Lag
		lineageTag: c6c5c099-4775-4f5c-91cd-070b295e6d33

	/// Pearson correlation between weekly freight change and lagged Portfolio Return across ISO weeks, at the current LagWeeks value.
	measure 'Freight-Equity Correlation (Weekly)' =
			
			VAR LagN = SELECTEDVALUE ( LagWeeks[LagWeeks], 0 )
			VAR Weeks =
			    CALCULATETABLE (
			        SUMMARIZE ( 'Date', 'Date'[ISOYear], 'Date'[ISOWeek] )
			    )
			VAR Base =
			    ADDCOLUMNS (
			        Weeks,
			        "@wix", 'Date'[ISOYear] * 54 + 'Date'[ISOWeek],
			        "@f",
			            VAR Y = 'Date'[ISOYear]
			            VAR W = 'Date'[ISOWeek]
			            RETURN
			                CALCULATE (
			                    SUMX (
			                        FILTER (
			                            freight,
			                            freight[Close] > 0 && freight[PrevClose] > 0
			                        ),
			                        LN ( freight[Close] ) - LN ( freight[PrevClose] )
			                    ),
			                    'Date'[ISOYear] = Y,
			                    'Date'[ISOWeek] = W
			                ),
			        "@e",
			            VAR Y = 'Date'[ISOYear]
			            VAR W = 'Date'[ISOWeek]
			            RETURN
			                CALCULATE (
			                    SUMX (
			                        FILTER (
			                            ADDCOLUMNS ( VALUES ( 'Date'[Date] ), "@r", [Portfolio Return] ),
			                            NOT ISBLANK ( [@r] ) && [@r] > -0.99
			                        ),
			                        LN ( 1 + [@r] )
			                    ),
			                    'Date'[ISOYear] = Y,
			                    'Date'[ISOWeek] = W
			                )
			    )
			VAR Clean = FILTER ( Base, NOT ISBLANK ( [@f] ) && NOT ISBLANK ( [@e] ) )
			VAR WithLag =
			    ADDCOLUMNS (
			        Clean,
			        "@elag",
			            VAR MyIx = [@wix]
			            RETURN MAXX ( FILTER ( Clean, [@wix] = MyIx + LagN ), [@e] )
			    )
			VAR Final = FILTER ( WithLag, NOT ISBLANK ( [@elag] ) )
			VAR N   = COUNTROWS ( Final )
			VAR SX  = SUMX ( Final, [@f] )
			VAR SY  = SUMX ( Final, [@elag] )
			VAR SXY = SUMX ( Final, [@f] * [@elag] )
			VAR SXX = SUMX ( Final, [@f] * [@f] )
			VAR SYY = SUMX ( Final, [@elag] * [@elag] )
			VAR Num = N * SXY - SX * SY
			VAR Den = SQRT ( ( N * SXX - SX * SX ) * ( N * SYY - SY * SY ) )
			RETURN
			    DIVIDE ( Num, Den )
		displayFolder: Lag
		lineageTag: 4775837e-5a06-4f30-8555-6072f250f719


	column Value
		formatString: 0.0000
		lineageTag: cef04a35-9a8e-46cb-95d6-2d92ac206273
