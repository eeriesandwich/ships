table _Measures
	lineageTag: 53520548-515a-48d3-ad3c-af4ea6964bdf

	measure Constituents = MAX ( LineagePortfolio[Constituents] )
		formatString: 0
		displayFolder: Composition
		lineageTag: 8e1c3e03-f78c-4a96-8eaf-a56dd073170d

	measure 'Constituents Traded' = MAX ( LineagePortfolio[ConstituentsTraded] )
		formatString: 0
		displayFolder: Composition
		lineageTag: 554c80af-ab7f-45b4-8e4a-8f9d0137285b

	measure 'Portfolio Return' =
			
			VAR MinN     = [MinConstituents Value]
			VAR Basis    = SELECTEDVALUE ( ReturnBasis[Basis], "Total" )
			VAR ExcludeE = SELECTEDVALUE ( IncludeEvents[Option], "Include" ) = "Exclude"
			RETURN
			    CALCULATE (
			        SWITCH ( Basis,
			            "Price", AVERAGE ( LineagePortfolio[PortfolioPriceReturn] ),
			            "Local", AVERAGE ( LineagePortfolio[PortfolioLocalReturn] ),
			            AVERAGE ( LineagePortfolio[PortfolioReturn] )
			        ),
			        KEEPFILTERS ( LineagePortfolio[ConstituentsTraded] >= MinN ),
			        KEEPFILTERS ( LineagePortfolio[USVenueOpen] = TRUE () ),
			        KEEPFILTERS ( NOT ( ExcludeE && LineagePortfolio[IsEventDay] ) )
			    )
		formatString: 0.0000%;-0.0000%;0.0000%
		displayFolder: Base
		lineageTag: 9fb51a5a-250f-4fad-af26-143a458cf048

	measure 'Freight Level Deviation' =
			
			VAR Mode     = SELECTEDVALUE ( FreightSeries[ChangeMode] )
			VAR Q        = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			VAR ExcludeE = SELECTEDVALUE ( IncludeEvents[Option], "Include" ) = "Exclude"
			VAR Panel =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                SUMMARIZE ( freight, 'Date'[Year], 'Date'[QuarterNumber] ),
			                REMOVEFILTERS ( 'Date'[QuarterNumber] ),
			                KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			            ),
			            "@qmean",
			                CALCULATE (
			                    AVERAGE ( freight[Close] ),
			                    KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			                ),
			            "@ymean",
			                CALCULATE (
			                    AVERAGE ( freight[Close] ),
			                    ALLEXCEPT ( 'Date', 'Date'[Year] ),
			                    KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			                )
			        ),
			        NOT ISBLANK ( [@qmean] )
			    )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Panel, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Panel, 'Date'[Year] = y ) )
			        ),
			        [@n] = 4
			    )
			VAR CompleteQ =
			    FILTER (
			        Panel,
			        'Date'[QuarterNumber] = Q
			            && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			    )
			RETURN
			    SWITCH (
			        Mode,
			        "Points", AVERAGEX ( CompleteQ, [@qmean] - [@ymean] ),
			        AVERAGEX ( CompleteQ, DIVIDE ( [@qmean] - [@ymean], [@ymean] ) )
			    )
		displayFolder: Freight
		lineageTag: 0a8f3d3c-1887-40c5-9a73-8b25e9d07924

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Freight Quarter Change' =
			
			VAR Mode     = SELECTEDVALUE ( FreightSeries[ChangeMode] )
			VAR Q        = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			VAR ExcludeE = SELECTEDVALUE ( IncludeEvents[Option], "Include" ) = "Exclude"
			VAR Panel =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( freight, 'Date'[Year], 'Date'[QuarterNumber] ),
			            REMOVEFILTERS ( 'Date'[QuarterNumber] ),
			            KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			        ),
			        "@last",
			            CALCULATE (
			                LASTNONBLANKVALUE ( 'Date'[Date], MAX ( freight[Close] ) ),
			                KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			            )
			    )
			VAR PanelWithPrev =
			    ADDCOLUMNS (
			        Panel,
			        "@prev",
			            VAR curY  = 'Date'[Year]
			            VAR curQ  = 'Date'[QuarterNumber]
			            VAR prevY = IF ( curQ = 1, curY - 1, curY )
			            VAR prevQ = IF ( curQ = 1, 4, curQ - 1 )
			            RETURN
			                MAXX (
			                    FILTER ( Panel, 'Date'[Year] = prevY && 'Date'[QuarterNumber] = prevQ ),
			                    [@last]
			                )
			    )
			VAR Complete =
			    FILTER ( PanelWithPrev, NOT ISBLANK ( [@prev] ) && NOT ISBLANK ( [@last] ) )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Complete, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Complete, 'Date'[Year] = y ) )
			        ),
			        [@n] = 4
			    )
			VAR CompleteQ =
			    FILTER (
			        Complete,
			        'Date'[QuarterNumber] = Q
			            && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			    )
			RETURN
			    SWITCH (
			        Mode,
			        "Points", AVERAGEX ( CompleteQ, [@last] - [@prev] ),
			        AVERAGEX ( CompleteQ, DIVIDE ( [@last] - [@prev], ABS ( [@prev] ) ) )
			    )
		displayFolder: Freight
		lineageTag: 966ca255-dbf8-4a60-a472-4c7ee3dfbf97

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Freight Quarter Change, within-year' =
			
			VAR Mode     = SELECTEDVALUE ( FreightSeries[ChangeMode] )
			VAR Q        = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			VAR ExcludeE = SELECTEDVALUE ( IncludeEvents[Option], "Include" ) = "Exclude"
			VAR Panel =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( freight, 'Date'[Year], 'Date'[QuarterNumber] ),
			            REMOVEFILTERS ( 'Date'[QuarterNumber] ),
			            KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			        ),
			        "@last",
			            CALCULATE (
			                LASTNONBLANKVALUE ( 'Date'[Date], MAX ( freight[Close] ) ),
			                KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			            )
			    )
			VAR PanelWithPrev =
			    ADDCOLUMNS (
			        Panel,
			        "@prev",
			            VAR curY  = 'Date'[Year]
			            VAR curQ  = 'Date'[QuarterNumber]
			            VAR prevY = IF ( curQ = 1, curY - 1, curY )
			            VAR prevQ = IF ( curQ = 1, 4, curQ - 1 )
			            RETURN
			                MAXX (
			                    FILTER ( Panel, 'Date'[Year] = prevY && 'Date'[QuarterNumber] = prevQ ),
			                    [@last]
			                )
			    )
			VAR PanelWithChange =
			    ADDCOLUMNS (
			        FILTER ( PanelWithPrev, NOT ISBLANK ( [@prev] ) && NOT ISBLANK ( [@last] ) ),
			        "@chg",
			            SWITCH (
			                Mode,
			                "Points", [@last] - [@prev],
			                DIVIDE ( [@last] - [@prev], ABS ( [@prev] ) )
			            )
			    )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( PanelWithChange, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( PanelWithChange, 'Date'[Year] = y ) )
			        ),
			        [@n] = 4
			    )
			VAR Dev =
			    ADDCOLUMNS (
			        FILTER (
			            PanelWithChange,
			            'Date'[QuarterNumber] = Q
			                && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			        ),
			        "@dev",
			            VAR y = 'Date'[Year]
			            RETURN [@chg] - AVERAGEX ( FILTER ( PanelWithChange, 'Date'[Year] = y ), [@chg] )
			    )
			RETURN
			    AVERAGEX ( Dev, [@dev] )
		displayFolder: Freight
		lineageTag: af20f24a-a21d-4163-89fd-7f6b306cc953

		annotation PBI_FormatHint = {"isGeneralNumber":true}

