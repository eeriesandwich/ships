table _Measures
	lineageTag: 53520548-515a-48d3-ad3c-af4ea6964bdf

	/// Count of active constituents in the lineage on the current date, before trading-day gating.
	measure Constituents = MAX ( LineagePortfolio[Constituents] )
		formatString: 0
		displayFolder: Composition
		lineageTag: 8e1c3e03-f78c-4a96-8eaf-a56dd073170d

	/// Count of active constituents that actually traded on the current US session, used by the MinConstituents gate.
	measure 'Constituents Traded' = MAX ( LineagePortfolio[ConstituentsTraded] )
		formatString: 0
		displayFolder: Composition
		lineageTag: 554c80af-ab7f-45b4-8e4a-8f9d0137285b

	/// Daily equal-weighted log return of the lineage's constituents in USD, dividend-adjusted. Gated by MinConstituents, USVenueOpen and the Events toggle. Switches between Total, Price and Local via ReturnBasis.
	measure 'Portfolio Return' =
			
			VAR MinN     = [MinConstituents Value]
			VAR Basis    = SELECTEDVALUE ( ReturnBasis[Basis], "Total" )
			VAR ExcludeE = SELECTEDVALUE ( IncludeEvents[Option], "Include" ) = "Exclude"
			RETURN
			    CALCULATE (
			        SWITCH ( Basis,
			            "Price", AVERAGE ( LineagePortfolio[PortfolioPriceReturn] ),
			            "Local", AVERAGE ( LineagePortfolio[PortfolioLocalReturn] ),
			            AVERAGE ( LineagePortfolio[PortfolioReturn] )
			        ),
			        KEEPFILTERS ( LineagePortfolio[ConstituentsTraded] >= MinN ),
			        KEEPFILTERS ( LineagePortfolio[USVenueOpen] = TRUE () ),
			        KEEPFILTERS ( NOT ( ExcludeE && LineagePortfolio[IsEventDay] ) )
			    )
		formatString: 0.0000%;-0.0000%;0.0000%
		displayFolder: Base
		lineageTag: 9fb51a5a-250f-4fad-af26-143a458cf048

	/// Average deviation of the quarter's mean freight close from the year's annual mean close, over complete years. Percent for BDTI and BDI, points for BCI.
	measure 'Freight Level Deviation' =
			
			VAR Mode     = SELECTEDVALUE ( FreightSeries[ChangeMode] )
			VAR Q        = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			VAR ExcludeE = SELECTEDVALUE ( IncludeEvents[Option], "Include" ) = "Exclude"
			VAR Panel =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                SUMMARIZE ( freight, 'Date'[Year], 'Date'[QuarterNumber] ),
			                REMOVEFILTERS ( 'Date'[QuarterNumber] ),
			                KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			            ),
			            "@qmean",
			                CALCULATE (
			                    AVERAGE ( freight[Close] ),
			                    KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			                ),
			            "@ymean",
			                CALCULATE (
			                    AVERAGE ( freight[Close] ),
			                    ALLEXCEPT ( 'Date', 'Date'[Year] ),
			                    KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			                )
			        ),
			        NOT ISBLANK ( [@qmean] )
			    )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Panel, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Panel, 'Date'[Year] = y ) )
			        ),
			        [@n] = 4
			    )
			VAR CompleteQ =
			    FILTER (
			        Panel,
			        'Date'[QuarterNumber] = Q
			            && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			    )
			RETURN
			    SWITCH (
			        Mode,
			        "Points", AVERAGEX ( CompleteQ, [@qmean] - [@ymean] ),
			        AVERAGEX ( CompleteQ, DIVIDE ( [@qmean] - [@ymean], [@ymean] ) )
			    )
		displayFolder: Freight
		lineageTag: 0a8f3d3c-1887-40c5-9a73-8b25e9d07924

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average close-to-close change in the freight index per quarter, over complete years. Respects the Events toggle.
	measure 'Freight Quarter Change' =
			
			VAR Mode     = SELECTEDVALUE ( FreightSeries[ChangeMode] )
			VAR Q        = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			VAR ExcludeE = SELECTEDVALUE ( IncludeEvents[Option], "Include" ) = "Exclude"
			VAR Panel =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( freight, 'Date'[Year], 'Date'[QuarterNumber] ),
			            REMOVEFILTERS ( 'Date'[QuarterNumber] ),
			            KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			        ),
			        "@last",
			            CALCULATE (
			                LASTNONBLANKVALUE ( 'Date'[Date], MAX ( freight[Close] ) ),
			                KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			            )
			    )
			VAR PanelWithPrev =
			    ADDCOLUMNS (
			        Panel,
			        "@prev",
			            VAR curY  = 'Date'[Year]
			            VAR curQ  = 'Date'[QuarterNumber]
			            VAR prevY = IF ( curQ = 1, curY - 1, curY )
			            VAR prevQ = IF ( curQ = 1, 4, curQ - 1 )
			            RETURN
			                MAXX (
			                    FILTER ( Panel, 'Date'[Year] = prevY && 'Date'[QuarterNumber] = prevQ ),
			                    [@last]
			                )
			    )
			VAR Complete =
			    FILTER ( PanelWithPrev, NOT ISBLANK ( [@prev] ) && NOT ISBLANK ( [@last] ) )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Complete, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Complete, 'Date'[Year] = y ) )
			        ),
			        [@n] = 4
			    )
			VAR CompleteQ =
			    FILTER (
			        Complete,
			        'Date'[QuarterNumber] = Q
			            && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			    )
			RETURN
			    SWITCH (
			        Mode,
			        "Points", AVERAGEX ( CompleteQ, [@last] - [@prev] ),
			        AVERAGEX ( CompleteQ, DIVIDE ( [@last] - [@prev], ABS ( [@prev] ) ) )
			    )
		displayFolder: Freight
		lineageTag: 966ca255-dbf8-4a60-a472-4c7ee3dfbf97

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Freight Quarter Change minus the year's own four-quarter mean, averaged across years.
	measure 'Freight Quarter Change, within-year' =
			
			VAR Mode     = SELECTEDVALUE ( FreightSeries[ChangeMode] )
			VAR Q        = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			VAR ExcludeE = SELECTEDVALUE ( IncludeEvents[Option], "Include" ) = "Exclude"
			VAR Panel =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( freight, 'Date'[Year], 'Date'[QuarterNumber] ),
			            REMOVEFILTERS ( 'Date'[QuarterNumber] ),
			            KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			        ),
			        "@last",
			            CALCULATE (
			                LASTNONBLANKVALUE ( 'Date'[Date], MAX ( freight[Close] ) ),
			                KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			            )
			    )
			VAR PanelWithPrev =
			    ADDCOLUMNS (
			        Panel,
			        "@prev",
			            VAR curY  = 'Date'[Year]
			            VAR curQ  = 'Date'[QuarterNumber]
			            VAR prevY = IF ( curQ = 1, curY - 1, curY )
			            VAR prevQ = IF ( curQ = 1, 4, curQ - 1 )
			            RETURN
			                MAXX (
			                    FILTER ( Panel, 'Date'[Year] = prevY && 'Date'[QuarterNumber] = prevQ ),
			                    [@last]
			                )
			    )
			VAR PanelWithChange =
			    ADDCOLUMNS (
			        FILTER ( PanelWithPrev, NOT ISBLANK ( [@prev] ) && NOT ISBLANK ( [@last] ) ),
			        "@chg",
			            SWITCH (
			                Mode,
			                "Points", [@last] - [@prev],
			                DIVIDE ( [@last] - [@prev], ABS ( [@prev] ) )
			            )
			    )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( PanelWithChange, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( PanelWithChange, 'Date'[Year] = y ) )
			        ),
			        [@n] = 4
			    )
			VAR Dev =
			    ADDCOLUMNS (
			        FILTER (
			            PanelWithChange,
			            'Date'[QuarterNumber] = Q
			                && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			        ),
			        "@dev",
			            VAR y = 'Date'[Year]
			            RETURN [@chg] - AVERAGEX ( FILTER ( PanelWithChange, 'Date'[Year] = y ), [@chg] )
			    )
			RETURN
			    AVERAGEX ( Dev, [@dev] )
		displayFolder: Freight
		lineageTag: af20f24a-a21d-4163-89fd-7f6b306cc953

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Count of complete years used by the Freight Quarter Change intervals. Helper.
	measure 'Freight Quarter Change N' =
			
			VAR Mode     = SELECTEDVALUE ( FreightSeries[ChangeMode] )
			VAR Q        = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			VAR ExcludeE = SELECTEDVALUE ( IncludeEvents[Option], "Include" ) = "Exclude"
			VAR Panel =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( freight, 'Date'[Year], 'Date'[QuarterNumber] ),
			            REMOVEFILTERS ( 'Date'[QuarterNumber] ),
			            KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			        ),
			        "@last",
			            CALCULATE (
			                LASTNONBLANKVALUE ( 'Date'[Date], MAX ( freight[Close] ) ),
			                KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			            )
			    )
			VAR PanelWithPrev =
			    ADDCOLUMNS (
			        Panel,
			        "@prev",
			            VAR curY  = 'Date'[Year]
			            VAR curQ  = 'Date'[QuarterNumber]
			            VAR prevY = IF ( curQ = 1, curY - 1, curY )
			            VAR prevQ = IF ( curQ = 1, 4, curQ - 1 )
			            RETURN
			                MAXX (
			                    FILTER ( Panel, 'Date'[Year] = prevY && 'Date'[QuarterNumber] = prevQ ),
			                    [@last]
			                )
			    )
			VAR Complete =
			    FILTER ( PanelWithPrev, NOT ISBLANK ( [@prev] ) && NOT ISBLANK ( [@last] ) )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Complete, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Complete, 'Date'[Year] = y ) )
			        ),
			        [@n] = 4
			    )
			VAR CompleteQ =
			    FILTER (
			        Complete,
			        'Date'[QuarterNumber] = Q
			            && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			    )
			RETURN
			    COUNTROWS ( CompleteQ )
		formatString: 0
		displayFolder: Freight\Intervals
		isHidden
		lineageTag: 238334f1-3962-4307-be8c-5083e0a7fe31

	/// Standard deviation of per-year freight quarter changes. Helper.
	measure 'Freight Quarter Change SD' =
			
			VAR Mode     = SELECTEDVALUE ( FreightSeries[ChangeMode] )
			VAR Q        = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			VAR ExcludeE = SELECTEDVALUE ( IncludeEvents[Option], "Include" ) = "Exclude"
			VAR Panel =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( freight, 'Date'[Year], 'Date'[QuarterNumber] ),
			            REMOVEFILTERS ( 'Date'[QuarterNumber] ),
			            KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			        ),
			        "@last",
			            CALCULATE (
			                LASTNONBLANKVALUE ( 'Date'[Date], MAX ( freight[Close] ) ),
			                KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			            )
			    )
			VAR PanelWithPrev =
			    ADDCOLUMNS (
			        Panel,
			        "@prev",
			            VAR curY  = 'Date'[Year]
			            VAR curQ  = 'Date'[QuarterNumber]
			            VAR prevY = IF ( curQ = 1, curY - 1, curY )
			            VAR prevQ = IF ( curQ = 1, 4, curQ - 1 )
			            RETURN
			                MAXX (
			                    FILTER ( Panel, 'Date'[Year] = prevY && 'Date'[QuarterNumber] = prevQ ),
			                    [@last]
			                )
			    )
			VAR Complete =
			    FILTER ( PanelWithPrev, NOT ISBLANK ( [@prev] ) && NOT ISBLANK ( [@last] ) )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Complete, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Complete, 'Date'[Year] = y ) )
			        ),
			        [@n] = 4
			    )
			VAR CompleteQ =
			    FILTER (
			        Complete,
			        'Date'[QuarterNumber] = Q
			            && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			    )
			RETURN
			    STDEVX.S (
			        CompleteQ,
			        SWITCH (
			            Mode,
			            "Points", [@last] - [@prev],
			            DIVIDE ( [@last] - [@prev], ABS ( [@prev] ) )
			        )
			    )
		isHidden
		displayFolder: Freight\Intervals
		lineageTag: 210788dd-ded1-4711-9888-890de2c8b068

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Lower bound of the 95% t-interval around the mean Freight Quarter Change.
	measure 'Freight Quarter Change t Lower' = ```
			
			VAR m  = [Freight Quarter Change]
			VAR sd = [Freight Quarter Change SD]
			VAR n  = [Freight Quarter Change N]
			RETURN IF ( n > 1, m - T.INV.2T ( 0.05, n - 1 ) * sd / SQRT ( n ) )
			
			```
		displayFolder: Freight\Intervals
		lineageTag: 3c9b8bd4-0b9c-427e-98bd-5a7a86a3fdcc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Upper bound of the 95% t-interval around the mean Freight Quarter Change.
	measure 'Freight Quarter Change t Upper' =
			
			VAR m  = [Freight Quarter Change]
			VAR sd = [Freight Quarter Change SD]
			VAR n  = [Freight Quarter Change N]
			RETURN IF ( n > 1, m + T.INV.2T ( 0.05, n - 1 ) * sd / SQRT ( n ) )
		displayFolder: Freight\Intervals
		lineageTag: 1eef6323-6cc2-476d-8f92-99df6169d5b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Minimum detectable effect at 80% power and 5% two-sided alpha for the Freight Quarter Change.
	measure 'Freight Quarter Change MDE' =
			
			VAR sd = [Freight Quarter Change SD]
			VAR n  = [Freight Quarter Change N]
			RETURN IF ( n > 1, ( T.INV ( 0.975, n - 1 ) + T.INV ( 0.80, n - 1 ) ) * sd / SQRT ( n ) )
		displayFolder: Freight\Intervals
		lineageTag: ee2c2dfe-d1f7-4844-a32d-84c0c712ee2f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Share of the seasonal coefficient attributed to the control factor, from the pre-computed mediator test.
	measure 'MT Mediated Share' =
			
			VAR EvScope = SELECTEDVALUE ( IncludeEvents[Option], "Include" )
			RETURN CALCULATE ( SELECTEDVALUE ( MediatorTest[mediated_share] ), MediatorTest[events] = EvScope )
		formatString: 0.0000
		displayFolder: MediatorTest
		lineageTag: e4dd9289-8a28-4701-83fb-809c8e7f86db


