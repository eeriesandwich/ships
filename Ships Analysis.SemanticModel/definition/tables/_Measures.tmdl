	measure 'Beta Sector' =
			
			VAR Panel =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( 'Date', 'Date'[Year], 'Date'[QuarterNumber] ),
			            REMOVEFILTERS ( 'Date' )
			        ),
			        "@y",  CALCULATE ( [Quarter Return] ),
			        "@xm", CALCULATE ( [Market Factor Quarter Return] ),
			        "@xs", CALCULATE ( [Sector Factor Quarter Return] ),
			        "@d1", IF ( 'Date'[QuarterNumber] = 1, 1, 0 ),
			        "@d2", IF ( 'Date'[QuarterNumber] = 2, 1, 0 ),
			        "@d3", IF ( 'Date'[QuarterNumber] = 3, 1, 0 )
			    )
			VAR Clean =
			    FILTER (
			        Panel,
			        NOT ISBLANK ( [@y] ) && NOT ISBLANK ( [@xm] ) && NOT ISBLANK ( [@xs] )
			    )
			VAR Betas = LINESTX ( Clean, [@y], [@xm], [@xs], [@d1], [@d2], [@d3] )
			RETURN MINX ( Betas, [Slope2] )
		formatString: 0.00
		displayFolder: Controls
		lineageTag: 2d82feaf-a2ef-48e6-8c57-09284f4a9c25

