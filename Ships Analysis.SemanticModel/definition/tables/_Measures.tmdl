			VAR CompleteQ =
			    FILTER (
			        Complete,
			        'Date'[QuarterNumber] = Q
			            && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			    )
			RETURN
			    STDEVX.S (
			        CompleteQ,
			        SWITCH (
			            Mode,
			            "Points", [@last] - [@prev],
			            DIVIDE ( [@last] - [@prev], ABS ( [@prev] ) )
			        )
			    )
		displayFolder: Freight
		lineageTag: 210788dd-ded1-4711-9888-890de2c8b068

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Freight Quarter Change t Lower' = ```
			
			VAR m  = [Freight Quarter Change]
			VAR sd = [Freight Quarter Change SD]
			VAR n  = [Freight Quarter Change N]
			RETURN IF ( n > 1, m - T.INV.2T ( 0.05, n - 1 ) * sd / SQRT ( n ) )
			
			```
		displayFolder: Freight
		lineageTag: 3c9b8bd4-0b9c-427e-98bd-5a7a86a3fdcc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Freight Quarter Change t Upper' =
			
			VAR m  = [Freight Quarter Change]
			VAR sd = [Freight Quarter Change SD]
			VAR n  = [Freight Quarter Change N]
			RETURN IF ( n > 1, m + T.INV.2T ( 0.05, n - 1 ) * sd / SQRT ( n ) )
		displayFolder: Freight
		lineageTag: 1eef6323-6cc2-476d-8f92-99df6169d5b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Freight Quarter Change MDE' =
			
			VAR sd = [Freight Quarter Change SD]
			VAR n  = [Freight Quarter Change N]
			RETURN IF ( n > 1, ( T.INV ( 0.975, n - 1 ) + T.INV ( 0.80, n - 1 ) ) * sd / SQRT ( n ) )
		displayFolder: Freight
		lineageTag: ee2c2dfe-d1f7-4844-a32d-84c0c712ee2f

