	measure 'Market Factor Quarter Return' =
			
			VAR MarketTickers = CALCULATETABLE ( VALUES ( Factor[Ticker] ), Factor[FactorKind] = "Market" )
			VAR Days = VALUES ( 'Date'[Date] )
			RETURN
			    AVERAGEX (
			        MarketTickers,
			        VAR t = Factor[Ticker]
			        VAR DailyRows =
			            CALCULATETABLE (
			                FILTER (
			                    ADDCOLUMNS ( Days, "@r", CALCULATE ( SUM ( ControlFactors[FactorReturn] ) ) ),
			                    NOT ISBLANK ( [@r] )
			                ),
			                ControlFactors[Ticker] = t
			            )
			        RETURN SUMX ( DailyRows, LN ( 1 + [@r] ) )
			    )
		displayFolder: Factors
		lineageTag: 6c294fd6-684f-42ac-a29a-4a7ca13a2a8f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sector Factor Quarter Return' =
			
			VAR L = SELECTEDVALUE ( Lineage[Lineage] )
			VAR SectorTickers =
			    CALCULATETABLE (
			        VALUES ( Factor[Ticker] ),
			        Factor[FactorKind] = "Sector",
			        Factor[SectorLineage] = L
			    )
			VAR Days = VALUES ( 'Date'[Date] )
			RETURN
			    AVERAGEX (
			        SectorTickers,
			        VAR t = Factor[Ticker]
			        VAR DailyRows =
			            CALCULATETABLE (
			                FILTER (
			                    ADDCOLUMNS ( Days, "@r", CALCULATE ( SUM ( ControlFactors[FactorReturn] ) ) ),
			                    NOT ISBLANK ( [@r] )
			                ),
			                ControlFactors[Ticker] = t
			            )
			        RETURN SUMX ( DailyRows, LN ( 1 + [@r] ) )
