	/// Sum of daily log Portfolio Return within the current quarter, gated by MinQuarterCoverage.
	measure 'Quarter Return' =
			
			VAR MinCov = [MinQuarterCoverage Value]
			VAR USDays =
			    CALCULATE ( COUNTROWS ( 'Date' ), NOT ISBLANK ( 'Date'[USSessionIndex] ) )
			VAR GatedDays =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( 'Date'[Date] ), "@r", [Portfolio Return] ),
			        NOT ISBLANK ( [@r] )
			    )
			VAR NGated = COUNTROWS ( GatedDays )
			RETURN
			    IF (
			        USDays > 0 && NGated >= MinCov * USDays,
			        SUMX ( GatedDays, LN ( 1 + [@r] ) )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Base
		lineageTag: d5203ce6-2373-4b75-b537-9e426c90fd8a


	/// Average equity Residual Quarter Return across years for the current quarter.
	measure 'Seasonal Mean' =
			
			VAR Q = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			VAR Panel =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                SUMMARIZE ( 'Date', 'Date'[Year], 'Date'[QuarterNumber] ),
			                REMOVEFILTERS ( 'Date'[QuarterNumber] )
			            ),
			            "@q", CALCULATE ( [Residual Quarter Return] )
			        ),
			        NOT ISBLANK ( [@q] )
			    )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Panel, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Panel, 'Date'[Year] = y ) )
			        ),
			        [@n] = 4
			    )
			VAR CompleteQ =
			    FILTER (
			        Panel,
			        'Date'[QuarterNumber] = Q
			            && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			    )
			RETURN
			    AVERAGEX ( CompleteQ, [@q] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seasonality
		lineageTag: a080b371-acd4-4275-be08-35741f562df2


	/// Average within-year deviation of equity Residual Quarter Return from the year's own four-quarter mean, over complete years in the current Specification.
	measure 'Seasonal Deviation' =
			
			VAR Q = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			VAR Panel =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                SUMMARIZE ( 'Date', 'Date'[Year], 'Date'[QuarterNumber] ),
			                REMOVEFILTERS ( 'Date'[QuarterNumber] )
			            ),
			            "@q", CALCULATE ( [Residual Quarter Return] )
			        ),
			        NOT ISBLANK ( [@q] )
			    )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Panel, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Panel, 'Date'[Year] = y ) )
			        ),
			        [@n] = 4
			    )
			VAR Dev =
			    ADDCOLUMNS (
			        FILTER (
			            Panel,
			            'Date'[QuarterNumber] = Q
			                && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			        ),
			        "@dev",
			            VAR y = 'Date'[Year]
			            RETURN [@q] - AVERAGEX ( FILTER ( Panel, 'Date'[Year] = y ), [@q] )
			    )
			RETURN
			    AVERAGEX ( Dev, [@dev] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seasonality
		lineageTag: b2f9c4f4-b75b-4b6b-bd02-264a535b2960

	/// Count of complete years in the current lineage used by the Seasonal Deviation panel.
	measure 'Years Used' =
			
			VAR Panel =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                SUMMARIZE ( 'Date', 'Date'[Year], 'Date'[QuarterNumber] ),
			                REMOVEFILTERS ( 'Date'[QuarterNumber] )
			            ),
			            "@q", CALCULATE ( [Residual Quarter Return] )
			        ),
			        NOT ISBLANK ( [@q] )
			    )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Panel, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Panel, 'Date'[Year] = y ) )
			        ),
			        [@n] = 4
			    )
			RETURN
			    COUNTROWS ( FullYears )
		formatString: 0
		displayFolder: Seasonality
		lineageTag: 68cd15c9-7eba-4624-b8b2-3642cd018695

	/// Years available for the current quarter after full-year gating. Helper.
	measure 'Seasonal Deviation N' =
			
			VAR Q = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			VAR Panel =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                SUMMARIZE ( 'Date', 'Date'[Year], 'Date'[QuarterNumber] ),
			                REMOVEFILTERS ( 'Date'[QuarterNumber] )
			            ),
			            "@q", CALCULATE ( [Residual Quarter Return] )
			        ),
			        NOT ISBLANK ( [@q] )
			    )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Panel, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Panel, 'Date'[Year] = y ) )
			        ),
			        [@n] = 4
			    )
			VAR Dev =
			    FILTER (
			        Panel,
			        'Date'[QuarterNumber] = Q
			            && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			    )
			RETURN
			    COUNTROWS ( Dev )
		formatString: 0
		isHidden
		displayFolder: Seasonality\Intervals
		lineageTag: b60ec728-b1f4-414f-9c44-190e5aa7117d

	/// Standard deviation of per-year within-year deviations for the current quarter. Helper.
	measure 'Seasonal Deviation SD' =
			
			VAR Q = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			VAR Panel =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                SUMMARIZE ( 'Date', 'Date'[Year], 'Date'[QuarterNumber] ),
			                REMOVEFILTERS ( 'Date'[QuarterNumber] )
			            ),
			            "@q", CALCULATE ( [Residual Quarter Return] )
			        ),
			        NOT ISBLANK ( [@q] )
			    )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Panel, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Panel, 'Date'[Year] = y ) )
			        ),
			        [@n] = 4
			    )
			VAR Dev =
			    ADDCOLUMNS (
			        FILTER (
			            Panel,
			            'Date'[QuarterNumber] = Q
			                && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			        ),
			        "@dev",
			            VAR y = 'Date'[Year]
			            RETURN [@q] - AVERAGEX ( FILTER ( Panel, 'Date'[Year] = y ), [@q] )
			    )
			RETURN
			    STDEVX.S ( Dev, [@dev] )
		isHidden
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seasonality\Intervals
		lineageTag: 4bd1c7e2-2a7a-422f-8468-ba967f85d49b


	/// Lower bound of the 95% t-interval around Seasonal Deviation.
	measure 'Seasonal Deviation t Lower' =
			
			VAR N    = [Seasonal Deviation N]
			VAR Mean = [Seasonal Deviation]
			VAR SD   = [Seasonal Deviation SD]
			RETURN
			    IF (
			        N > 1,
			        Mean - T.INV.2T ( 0.05, N - 1 ) * DIVIDE ( SD, SQRT ( N ) )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seasonality\Intervals
		lineageTag: 9936a58e-23e8-4cfc-a389-1ff1c61cbc7e


	/// Upper bound of the 95% t-interval around Seasonal Deviation.
	measure 'Seasonal Deviation t Upper' =
			
			VAR N    = [Seasonal Deviation N]
			VAR Mean = [Seasonal Deviation]
			VAR SD   = [Seasonal Deviation SD]
			RETURN
			    IF (
			        N > 1,
			        Mean + T.INV.2T ( 0.05, N - 1 ) * DIVIDE ( SD, SQRT ( N ) )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seasonality\Intervals
		lineageTag: 3adb8616-fb6d-4a3e-882d-6af1d6e2987f


	/// Minimum detectable effect for Seasonal Deviation at 80% power and 5% two-sided alpha.
	measure 'Seasonal Deviation MDE' =
			
			VAR N  = [Seasonal Deviation N]
			VAR SD = [Seasonal Deviation SD]
			RETURN
			    IF (
			        N > 1,
			        ( T.INV.2T ( 0.05, N - 1 ) + T.INV ( 0.80, N - 1 ) ) * DIVIDE ( SD, SQRT ( N ) )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seasonality\Intervals
		lineageTag: 0cb304f3-3f66-44fd-9b08-2a7e28169427


	/// Running sum of within-year Seasonal Deviations from Q1 to the current quarter.
	measure 'Seasonal Deviation Cumulative' =
			
			VAR CurrentQ = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentQ ),
			        SUMX (
			            FILTER (
			                CALCULATETABLE (
			                    VALUES ( 'Date'[QuarterNumber] ),
			                    REMOVEFILTERS ( 'Date'[QuarterNumber] )
			                ),
			                'Date'[QuarterNumber] <= CurrentQ
			            ),
			            VAR Q = 'Date'[QuarterNumber]
			            RETURN CALCULATE ( [Seasonal Deviation], 'Date'[QuarterNumber] = Q )
			        )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seasonality
		lineageTag: f24595b4-97c7-45b1-93ce-91369f858e31


	/// Running sum of within-year Freight Quarter Change deviations from Q1 to the current quarter.
	measure 'Freight Quarter Change Cumulative' =
			
			VAR CurrentQ = SELECTEDVALUE ( 'Date'[QuarterNumber] )
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentQ ),
			        SUMX (
			            FILTER (
			                CALCULATETABLE (
			                    VALUES ( 'Date'[QuarterNumber] ),
			                    REMOVEFILTERS ( 'Date'[QuarterNumber] )
			                ),
			                'Date'[QuarterNumber] <= CurrentQ
			            ),
			            VAR Q = 'Date'[QuarterNumber]
			            RETURN CALCULATE ( [Freight Quarter Change, within-year], 'Date'[QuarterNumber] = Q )
			        )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Freight
		lineageTag: 096aac8e-1595-44c9-bdd2-670a4cdcd5ed


	/// Sum of daily log Portfolio Return within the current month.
	measure 'Monthly Return' =
			
			VAR MinCov = [MinQuarterCoverage Value]
			VAR USDays =
			    CALCULATE ( COUNTROWS ( 'Date' ), NOT ISBLANK ( 'Date'[USSessionIndex] ) )
			VAR GatedDays =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( 'Date'[Date] ), "@r", [Portfolio Return] ),
			        NOT ISBLANK ( [@r] )
			    )
			VAR NGated = COUNTROWS ( GatedDays )
			RETURN
			    IF (
			        USDays > 0 && NGated >= MinCov * USDays,
			        SUMX ( GatedDays, LN ( 1 + [@r] ) )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seasonality\Monthly
		lineageTag: a5d0ace8-1780-453c-9fe0-6d97157e6752

	/// Average within-year deviation of Monthly Return from the year's own twelve-month mean.
	measure 'Monthly Deviation' =
			
			VAR M = SELECTEDVALUE ( 'Date'[MonthNumber] )
			VAR Panel =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                SUMMARIZE ( 'Date', 'Date'[Year], 'Date'[MonthNumber] ),
			                REMOVEFILTERS ( 'Date'[MonthNumber] )
			            ),
			            "@r", CALCULATE ( [Monthly Return] )
			        ),
			        NOT ISBLANK ( [@r] )
			    )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Panel, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Panel, 'Date'[Year] = y ) )
			        ),
			        [@n] = 12
			    )
			VAR Dev =
			    ADDCOLUMNS (
			        FILTER (
			            Panel,
			            'Date'[MonthNumber] = M
			                && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			        ),
			        "@dev",
			            VAR y = 'Date'[Year]
			            RETURN [@r] - AVERAGEX ( FILTER ( Panel, 'Date'[Year] = y ), [@r] )
			    )
			RETURN
			    AVERAGEX ( Dev, [@dev] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seasonality\Monthly
		lineageTag: 7acfdb3d-5801-4318-9afc-c0640ce0d882


	/// Count of years with all twelve months present. Helper.
	measure 'Monthly Years Used' =
			
			VAR Panel =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                SUMMARIZE ( 'Date', 'Date'[Year], 'Date'[MonthNumber] ),
			                REMOVEFILTERS ( 'Date'[MonthNumber] )
			            ),
			            "@r", CALCULATE ( [Monthly Return] )
			        ),
			        NOT ISBLANK ( [@r] )
			    )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Panel, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Panel, 'Date'[Year] = y ) )
			        ),
			        [@n] = 12
			    )
			RETURN
			    COUNTROWS ( FullYears )
		formatString: 0
		isHidden
		displayFolder: Seasonality\Monthly
		lineageTag: bfec3de1-a373-494c-8cf6-0430fff646b9

	/// Average close-to-close change in the freight index per month, over complete years.
	measure 'Freight Monthly Change' =
			
			VAR Mode     = SELECTEDVALUE ( FreightSeries[ChangeMode] )
			VAR M        = SELECTEDVALUE ( 'Date'[MonthNumber] )
			VAR ExcludeE = SELECTEDVALUE ( IncludeEvents[Option], "Include" ) = "Exclude"
			VAR Panel =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( freight, 'Date'[Year], 'Date'[MonthNumber] ),
			            REMOVEFILTERS ( 'Date'[MonthNumber] ),
			            KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			        ),
			        "@last",
			            CALCULATE (
			                LASTNONBLANKVALUE ( 'Date'[Date], MAX ( freight[Close] ) ),
			                KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			            )
			    )
			VAR PanelWithPrev =
			    ADDCOLUMNS (
			        Panel,
			        "@prev",
			            VAR curY = 'Date'[Year]
			            VAR curM = 'Date'[MonthNumber]
			            VAR prevY = IF ( curM = 1, curY - 1, curY )
			            VAR prevM = IF ( curM = 1, 12, curM - 1 )
			            RETURN
			                MAXX (
			                    FILTER ( Panel, 'Date'[Year] = prevY && 'Date'[MonthNumber] = prevM ),
			                    [@last]
			                )
			    )
			VAR Complete =
			    FILTER ( PanelWithPrev, NOT ISBLANK ( [@prev] ) && NOT ISBLANK ( [@last] ) )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( Complete, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( Complete, 'Date'[Year] = y ) )
			        ),
			        [@n] = 12
			    )
			VAR CompleteM =
			    FILTER (
			        Complete,
			        'Date'[MonthNumber] = M
			            && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			    )
			RETURN
			    SWITCH (
			        Mode,
			        "Points", AVERAGEX ( CompleteM, [@last] - [@prev] ),
			        AVERAGEX ( CompleteM, DIVIDE ( [@last] - [@prev], ABS ( [@prev] ) ) )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Freight\Monthly
		lineageTag: 89dd16eb-4eaf-4c17-be8b-4e0a46e933d9

	/// Freight Monthly Change minus the year's own twelve-month mean, averaged across years.
	measure 'Freight Monthly Deviation' =
			
			VAR Mode     = SELECTEDVALUE ( FreightSeries[ChangeMode] )
			VAR M        = SELECTEDVALUE ( 'Date'[MonthNumber] )
			VAR ExcludeE = SELECTEDVALUE ( IncludeEvents[Option], "Include" ) = "Exclude"
			VAR Panel =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( freight, 'Date'[Year], 'Date'[MonthNumber] ),
			            REMOVEFILTERS ( 'Date'[MonthNumber] ),
			            KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			        ),
			        "@last",
			            CALCULATE (
			                LASTNONBLANKVALUE ( 'Date'[Date], MAX ( freight[Close] ) ),
			                KEEPFILTERS ( NOT ( ExcludeE && freight[IsEventDay] ) )
			            )
			    )
			VAR PanelWithPrev =
			    ADDCOLUMNS (
			        Panel,
			        "@prev",
			            VAR curY = 'Date'[Year]
			            VAR curM = 'Date'[MonthNumber]
			            VAR prevY = IF ( curM = 1, curY - 1, curY )
			            VAR prevM = IF ( curM = 1, 12, curM - 1 )
			            RETURN
			                MAXX (
			                    FILTER ( Panel, 'Date'[Year] = prevY && 'Date'[MonthNumber] = prevM ),
			                    [@last]
			                )
			    )
			VAR PanelWithChange =
			    ADDCOLUMNS (
			        FILTER ( PanelWithPrev, NOT ISBLANK ( [@prev] ) && NOT ISBLANK ( [@last] ) ),
			        "@chg",
			            SWITCH (
			                Mode,
			                "Points", [@last] - [@prev],
			                DIVIDE ( [@last] - [@prev], ABS ( [@prev] ) )
			            )
			    )
			VAR FullYears =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT ( SELECTCOLUMNS ( PanelWithChange, "Y", 'Date'[Year] ) ),
			            "@n", VAR y = [Y] RETURN COUNTROWS ( FILTER ( PanelWithChange, 'Date'[Year] = y ) )
			        ),
			        [@n] = 12
			    )
			VAR Dev =
			    ADDCOLUMNS (
			        FILTER (
			            PanelWithChange,
			            'Date'[MonthNumber] = M
			                && 'Date'[Year] IN SELECTCOLUMNS ( FullYears, "Y", [Y] )
			        ),
			        "@dev",
			            VAR y = 'Date'[Year]
			            RETURN [@chg] - AVERAGEX ( FILTER ( PanelWithChange, 'Date'[Year] = y ), [@chg] )
			    )
			RETURN
			    AVERAGEX ( Dev, [@dev] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Freight\Monthly
		lineageTag: 2d8e18d2-53c6-4595-903d-16018d5f7330

	/// Standard deviation of per-year Tanker contrasts. Helper.
	measure 'Equity Contrast Tanker SD' =
			
			VAR Years =
			    CALCULATETABLE (
			        VALUES ( 'Date'[Year] ),
			        REMOVEFILTERS ( 'Date'[QuarterNumber] ),
			        Lineage[Lineage] = "Tanker"
			    )
			VAR Panel =
			    FILTER (
			        ADDCOLUMNS (
			            Years,
			            "@c",
			                VAR y = 'Date'[Year]
			                VAR q1 = CALCULATE ( [Residual Quarter Return], 'Date'[Year] = y, 'Date'[QuarterNumber] = 1, Lineage[Lineage] = "Tanker" )
			                VAR q2 = CALCULATE ( [Residual Quarter Return], 'Date'[Year] = y, 'Date'[QuarterNumber] = 2, Lineage[Lineage] = "Tanker" )
			                VAR q3 = CALCULATE ( [Residual Quarter Return], 'Date'[Year] = y, 'Date'[QuarterNumber] = 3, Lineage[Lineage] = "Tanker" )
			                VAR q4 = CALCULATE ( [Residual Quarter Return], 'Date'[Year] = y, 'Date'[QuarterNumber] = 4, Lineage[Lineage] = "Tanker" )
			                RETURN
			                    IF (
			                        NOT ( ISBLANK ( q1 ) || ISBLANK ( q2 ) || ISBLANK ( q3 ) || ISBLANK ( q4 ) ),
			                        ( q4 + q1 - q2 - q3 ) / 2
			                    )
			        ),
			        NOT ISBLANK ( [@c] )
			    )
			RETURN
			    STDEVX.S ( Panel, [@c] )
		formatString: 0.00%;-0.00%;0.00%
		isHidden
		displayFolder: Seasonality\Confirmatory
		lineageTag: 9136786e-62a7-4db5-9c4f-7951639531f5

	/// Pre-registered Tanker (Q4+Q1) minus (Q2+Q3) seasonal contrast, point estimate under current Specification.
	measure 'Equity Contrast Tanker Point' =
			
			VAR Years =
			    CALCULATETABLE (
			        VALUES ( 'Date'[Year] ),
			        REMOVEFILTERS ( 'Date'[QuarterNumber] ),
			        Lineage[Lineage] = "Tanker"
			    )
			VAR Panel =
			    FILTER (
			        ADDCOLUMNS (
			            Years,
			            "@c",
			                VAR y = 'Date'[Year]
			                VAR q1 = CALCULATE ( [Residual Quarter Return], 'Date'[Year] = y, 'Date'[QuarterNumber] = 1, Lineage[Lineage] = "Tanker" )
			                VAR q2 = CALCULATE ( [Residual Quarter Return], 'Date'[Year] = y, 'Date'[QuarterNumber] = 2, Lineage[Lineage] = "Tanker" )
			                VAR q3 = CALCULATE ( [Residual Quarter Return], 'Date'[Year] = y, 'Date'[QuarterNumber] = 3, Lineage[Lineage] = "Tanker" )
			                VAR q4 = CALCULATE ( [Residual Quarter Return], 'Date'[Year] = y, 'Date'[QuarterNumber] = 4, Lineage[Lineage] = "Tanker" )
			                RETURN
			                    IF (
			                        NOT ( ISBLANK ( q1 ) || ISBLANK ( q2 ) || ISBLANK ( q3 ) || ISBLANK ( q4 ) ),
			                        ( q4 + q1 - q2 - q3 ) / 2
			                    )
			        ),
			        NOT ISBLANK ( [@c] )
			    )
			RETURN
			    AVERAGEX ( Panel, [@c] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seasonality\Confirmatory
		lineageTag: a574cc62-46b4-4fd1-91de-7d67c83053f2

	/// Count of years available for the Tanker contrast. Helper.
	measure 'Equity Contrast Tanker N' =
			
			VAR Years =
			    CALCULATETABLE (
			        VALUES ( 'Date'[Year] ),
			        REMOVEFILTERS ( 'Date'[QuarterNumber] ),
			        Lineage[Lineage] = "Tanker"
			    )
			VAR Panel =
			    FILTER (
			        ADDCOLUMNS (
			            Years,
			            "@c",
			                VAR y = 'Date'[Year]
			                VAR q1 = CALCULATE ( [Residual Quarter Return], 'Date'[Year] = y, 'Date'[QuarterNumber] = 1, Lineage[Lineage] = "Tanker" )
			                VAR q2 = CALCULATE ( [Residual Quarter Return], 'Date'[Year] = y, 'Date'[QuarterNumber] = 2, Lineage[Lineage] = "Tanker" )
			                VAR q3 = CALCULATE ( [Residual Quarter Return], 'Date'[Year] = y, 'Date'[QuarterNumber] = 3, Lineage[Lineage] = "Tanker" )
			                VAR q4 = CALCULATE ( [Residual Quarter Return], 'Date'[Year] = y, 'Date'[QuarterNumber] = 4, Lineage[Lineage] = "Tanker" )
			                RETURN
			                    IF (
			                        NOT ( ISBLANK ( q1 ) || ISBLANK ( q2 ) || ISBLANK ( q3 ) || ISBLANK ( q4 ) ),
			                        ( q4 + q1 - q2 - q3 ) / 2
			                    )
			        ),
			        NOT ISBLANK ( [@c] )
			    )
			RETURN
			    COUNTROWS ( Panel )
		formatString: 0
		isHidden
		displayFolder: Seasonality\Confirmatory
		lineageTag: 7fec9516-80c2-4396-abd6-e29bcc9da0d2

	/// t-statistic for the Tanker (Q4+Q1) vs (Q2+Q3) contrast.
	measure 'Equity Contrast Tanker t' =
			
			VAR M  = [Equity Contrast Tanker Point]
			VAR SD = [Equity Contrast Tanker SD]
			VAR N  = [Equity Contrast Tanker N]
			RETURN IF ( N > 1, M / ( SD / SQRT ( N ) ) )
		formatString: 0.00
		displayFolder: Seasonality\Confirmatory
		lineageTag: d9724c2a-484e-4219-8de0-5c696413f135


	/// One-sided upper-tail p-value for the Tanker contrast (hypothesis: positive).
	measure 'Equity Contrast Tanker p one-sided' =
			
			VAR N = [Equity Contrast Tanker N]
			VAR T = [Equity Contrast Tanker t]
			RETURN IF ( N > 1, 1 - T.DIST ( T, N - 1, TRUE () ) )
		formatString: 0.0000
		displayFolder: Seasonality\Confirmatory
		lineageTag: 458597e4-fe90-4f05-967c-0efa7cce49c8

	/// t-statistic for the DryBulk Q1 one-sided negative test.
	measure 'Equity Contrast DryBulk Q1 t' =
			
			VAR M  = CALCULATE ( [Seasonal Deviation], 'Date'[QuarterNumber] = 1, Lineage[Lineage] = "DryBulk" )
			VAR SD = CALCULATE ( [Seasonal Deviation SD], 'Date'[QuarterNumber] = 1, Lineage[Lineage] = "DryBulk" )
			VAR N  = CALCULATE ( [Seasonal Deviation N], 'Date'[QuarterNumber] = 1, Lineage[Lineage] = "DryBulk" )
			RETURN IF ( N > 1, M / ( SD / SQRT ( N ) ) )
		formatString: 0.00
		displayFolder: Seasonality\Confirmatory
		lineageTag: 2a2c0187-fd6c-4743-adb9-d32d732c6ace

	/// One-sided lower-tail p-value for the DryBulk Q1 test (hypothesis: negative).
	measure 'Equity Contrast DryBulk Q1 p one-sided' =
			
			VAR N = CALCULATE ( [Seasonal Deviation N], 'Date'[QuarterNumber] = 1, Lineage[Lineage] = "DryBulk" )
			VAR T = [Equity Contrast DryBulk Q1 t]
			RETURN IF ( N > 1, T.DIST ( T, N - 1, TRUE () ) )
		formatString: 0.0000
		displayFolder: Seasonality\Confirmatory
		lineageTag: cfacc3eb-a534-4b46-8f9d-7ce21c8bdcaa

	/// Pre-registered DryBulk Q1 Seasonal Deviation under current Specification. Hypothesis: negative.
	measure 'Equity Contrast DryBulk Q1 Point' =
			
			CALCULATE ( [Seasonal Deviation], 'Date'[QuarterNumber] = 1, Lineage[Lineage] = "DryBulk" )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seasonality\Confirmatory
		lineageTag: b398e927-0055-431d-a16b-63464d8acb41

	/// Count of years used by the DryBulk Q1 test. Helper.
	measure 'Equity Contrast DryBulk Q1 N' =
			
			CALCULATE ( [Seasonal Deviation N], 'Date'[QuarterNumber] = 1, Lineage[Lineage] = "DryBulk" )
		formatString: 0
		isHidden
		displayFolder: Seasonality\Confirmatory
