          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Seasonal coefficient decomposition: raw, direct, and mediated'"
                }
              }
            },
            "heading": {
              "expr": {
                "Literal": {
                  "Value": "'Heading5'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'For each freight-factor-quarter combination, the chart shows the raw seasonal coefficient from the univariate regression, the direct coefficient after controlling for the factor, and the mediated component (β·δ) that the factor accounts for. Across all six combinations, the direct coefficient is close to the raw one, and the mediated component stays near zero. The headline tanker specification therefore controls for Brent, and the dry bulk headline stays market-only. The ratio-based decision rule in check_phase4.py reports a narrow bootstrap interval for the tanker rows and a wide one for the dry bulk rows, which reflects weaker raw coefficients in dry bulk rather than a stronger factor channel.'"
                }
              }
            },
            "alignment": {
              "expr": {
                "Literal": {
                  "Value": "'left'"
                }
              }
            },
            "heading": {
              "expr": {
                "Literal": {
                  "Value": "'Heading2'"
                }
              }
            },
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'For each freight-factor-quarter combination, the chart shows the raw seasonal coefficient from the univariate regression, the direct coefficient after controlling for the factor, and the mediated component (β·δ) that the factor accounts for. Across all six combinations, the direct coefficient is close to the raw one, and the mediated component stays near zero. The headline tanker specification therefore controls for Brent, and the dry bulk headline stays market-only. The ratio-based decision rule in check_phase4.py reports a narrow bootstrap interval for the tanker rows and a wide one for the dry bulk rows, which reflects weaker raw coefficients in dry bulk rather than a stronger factor channel.'"
                }
              }
            }
          }
        }
